{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "godeye-os",
	"compatibility_date": "2026-09-17",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"main": ".open-next/worker.js",
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	}
}
