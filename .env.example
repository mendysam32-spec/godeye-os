# MEDUSA OS — env (cloud + windows)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: default provider keys for demo (user vault overrides)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# NVIDIA_API_KEY=nvapi-...

# Optional: "Save project to Google Drive" — Google Cloud Console > APIs &
# Services > Credentials > OAuth client ID (type "Web application").
# Add these Authorized redirect URIs (no query strings, must match exactly):
#   http://localhost:3000/connectors
#   http://localhost:3000/settings
#   https://<your-domain>/connectors
#   https://<your-domain>/settings
# Scope used: drive.file (only files MEDUSA creates).
# NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Web clients also need the secret for the server-side token exchange. Keep it
# server-only (never NEXT_PUBLIC_) and also set it on Cloudflare:
#   npx wrangler secret put GOOGLE_DRIVE_CLIENT_SECRET
# GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-...
